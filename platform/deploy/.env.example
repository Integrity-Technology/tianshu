# ============================================================================
# 天枢 · 大模型内容安全攻防平台   环境变量样例
# 复制为 .env 后修改；生产环境必须修改的项已标 [必改]
# 注意：本文件面向 Docker Compose（数据目录 /app/data）。裸机部署请勿直接复制，
#       数据路径需改为实际目录，或参考仓库根《部署文档.md》第 5.3 节。
# ============================================================================

# ---------------------------------------------------------------- 基础
PLATFORM_VERSION=1.0.16
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8848
PLATFORM_DATA=/app/data
# 访问日志（data/logs/access.log，20MB 自动轮转一份）
PLATFORM_ACCESS_LOG=1
# 单请求体上限（字节，默认 2MB）
PLATFORM_MAX_BODY=2097152
PLATFORM_MAX_CONN=128
PLATFORM_REQUEST_TIMEOUT=20

# ---------------------------------------------------------------- 认证与会话
# on=必须登录（生产默认）；off=仅限本机开发排障，禁止在生产使用
PLATFORM_AUTH=on
# 会话有效期（秒）：8 小时；勾选“7 天免登录”用 REMEMBER_TTL
PLATFORM_SESSION_TTL=28800
PLATFORM_REMEMBER_TTL=604800
# Cookie Secure：auto（跟随 HTTPS）/ 1（仅 HTTPS，生产建议）/ 0
PLATFORM_COOKIE_SECURE=auto
PLATFORM_COOKIE_SAMESITE=Lax
# 反向代理场景（Nginx/SLB）设为 1，才会信任 X-Forwarded-Proto，并跳过回环 Host 校验
PLATFORM_TRUST_PROXY=1
# 允许访问的域名（逗号分隔）；反代未开 TRUST_PROXY 时用于放行公网域名
PLATFORM_ALLOWED_HOSTS=tianshu.example.com
# Host 头校验开关（1 默认开启；仅排障时可关）
PLATFORM_HOST_CHECK=1

# ---------------------------------------------------------------- 初始账号
# [必改] 首次初始化（数据库为空）时创建的管理员；初始化后修改此处不再生效
PLATFORM_ADMIN_ACCOUNT=admin
PLATFORM_ADMIN_PASSWORD=Admin@123456
PLATFORM_ADMIN_NAME=系统管理员
# 存量/新建账号的默认口令（仅用于演示数据初始化）
PLATFORM_DEFAULT_USER_PASSWORD=User@123456
# 首次登录是否强制改密（生产建议 1）
PLATFORM_FORCE_PASSWORD_CHANGE=1

# ---------------------------------------------------------------- 登录安全
PLATFORM_MAX_LOGIN_FAIL=5
PLATFORM_LOCK_MINUTES=15
PLATFORM_LOGIN_RPM=30
PLATFORM_PASSWORD_MIN=8

# ---------------------------------------------------------------- 传输安全
# 仅在 HTTPS 反代之后启用 HSTS
PLATFORM_HSTS=0

# ---------------------------------------------------------------- 运维
PLATFORM_LOG_DIR=/app/data/logs
PLATFORM_BACKUP_DIR=/app/data/backups
